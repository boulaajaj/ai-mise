# Derived, rebuildable state — never versioned (ADR-0004 §4)
**/ops/index.db
*.sqlite
*.db

# Local scratch
.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/

# Approval store contents are per-installation (schemas are versioned; receipts of a real installation live with that installation)
control-plane/approval/approval-store/*
!control-plane/approval/approval-store/.gitkeep

# One-time session helper scripts (root level) - never commit (retro-log lesson, 4th
# occurrence: the rule said .sh, so a .py walked straight past it)
/*.sh
/*.py
# install.sh is the exception. It is the product, not a session helper, and it
# was silently skipped by the rule above until this line was added.
!/install.sh

# Mind map: generated on demand, not versioned (ADR-0012 decision 6 supersedes
# ADR-0006 decision 3 - `python tools/generate_mindmap.py` still works locally)
docs/mindmap.md
